# Copia este archivo como .env y reemplaza los valores con los reales.
# NUNCA subas el archivo .env al repositorio.

# Conexión para la app (pooler, puerto 6543)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones (puerto 5432)
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/postgres"

# Puerto del backend
PORT=3001
