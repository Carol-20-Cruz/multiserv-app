{
  "info": {
    "name": "MultiServ API",
    "description": "Pruebas de API del backend de MultiServ (Calidad de Software). Correr completa y en orden con el Collection Runner o con newman (npm run test:api en backend/). Cada corrida crea datos nuevos y ficticios con prefijo API-. Trazabilidad prueba ↔ SWR: docs/calidad/09_Postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenDueno}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Auth",
      "description": "Inicio de sesión y permisos por rol (SWR-AUTH-001, SWR-AUTH-008, AJ-03).",
      "item": [
        {
          "name": "API-02 Login con contraseña incorrecta → 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Inicio de corrida: limpia lo que dejó la anterior y genera datos nuevos.",
                  "[\"run\",\"telefono\",\"tokenDueno\",\"tokenTecnico\",\"clienteId\",\"tipoEquipoId\",\"equipoId\",\"ordenId\",\"numeroOrden\",\"valorCotizado\",\"totalPagado\",\"saldo\",\"repuestoId\"].forEach((v) => pm.collectionVariables.unset(v));",
                  "const run = String(Date.now());",
                  "pm.collectionVariables.set('run', run);",
                  "// Celular ficticio de 10 dígitos que empieza por 3 (único por corrida).",
                  "pm.collectionVariables.set('telefono', '3' + run.slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('mensaje \"Credenciales inválidas\" (no revela si el correo existe)', () => {",
                  "  pm.expect(cuerpo.message).to.eql('Credenciales inválidas');",
                  "});",
                  "pm.test('no entrega token', () => pm.expect(cuerpo).to.not.have.property('accessToken'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "SWR-AUTH-001. Un solo intento fallido por corrida; va ANTES del login correcto, que reinicia el contador de intentos (la cuenta nunca llega a bloquearse). También prepara los datos nuevos de la corrida.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoDueno}}\",\n  \"password\": \"API-incorrecta-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "API-01 Login Dueño correcto → 200 y token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si esta petición base falla, el resto de la corrida no tiene sentido:",
                  "// se detiene para no producir fallos en cadena.",
                  "function detenerSi(condicion) {",
                  "  if (condicion) pm.execution.setNextRequest(null);",
                  "}",
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('passwordDueno está configurada en el environment (current value)', () => {",
                  "  pm.expect(pm.environment.get('passwordDueno'), 'Escribe la contraseña en el current value del environment').to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('accessToken con forma de JWT', () => {",
                  "  pm.expect(cuerpo.accessToken).to.be.a('string').and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
                  "});",
                  "pm.test('usuario con rol DUENO y sin datos de contraseña', () => {",
                  "  pm.expect(cuerpo.usuario.rol).to.eql('DUENO');",
                  "  pm.expect(cuerpo.usuario).to.not.have.any.keys('password', 'passwordHash');",
                  "});",
                  "const ok = pm.response.code === 200 && typeof cuerpo.accessToken === 'string';",
                  "if (ok) pm.collectionVariables.set('tokenDueno', cuerpo.accessToken);",
                  "detenerSi(!ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "SWR-AUTH-001. Guarda el token del Dueño en la variable de colección tokenDueno (la usa toda la colección).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoDueno}}\",\n  \"password\": \"{{passwordDueno}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "AUX-01 Login Técnico → 200 y token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si esta petición base falla, el resto de la corrida no tiene sentido:",
                  "// se detiene para no producir fallos en cadena.",
                  "function detenerSi(condicion) {",
                  "  if (condicion) pm.execution.setNextRequest(null);",
                  "}",
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('usuario con rol TECNICO', () => pm.expect(cuerpo.usuario && cuerpo.usuario.rol).to.eql('TECNICO'));",
                  "const ok = pm.response.code === 200 && typeof cuerpo.accessToken === 'string';",
                  "if (ok) pm.collectionVariables.set('tokenTecnico', cuerpo.accessToken);",
                  "detenerSi(!ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Preparación para API-04. Guarda tokenTecnico.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoTecnico}}\",\n  \"password\": \"{{passwordTecnico}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "API-03 GET /ordenes sin token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('no devuelve datos de órdenes', () => pm.expect(cuerpo).to.not.have.property('datos'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordenes"
              ]
            },
            "description": "SWR-AUTH-008. Sin token no se accede a ninguna ruta protegida.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "API-04 Técnico pide /repuestos → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 403 Forbidden (token válido pero rol sin permiso)', () => pm.response.to.have.status(403));",
                  "pm.test('no devuelve el listado de repuestos', () => pm.expect(cuerpo).to.not.have.property('datos'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repuestos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repuestos"
              ]
            },
            "description": "SWR-AUTH-008 / AJ-03. El inventario es solo del Dueño: el Técnico, aunque tenga un token válido, recibe 403.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenTecnico}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 Clientes",
      "description": "Registro de clientes y teléfono único (SWR-CLI-001, SWR-CLI-004 / AJ-04).",
      "item": [
        {
          "name": "API-05a Crear cliente con teléfono nuevo → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si esta petición base falla, el resto de la corrida no tiene sentido:",
                  "// se detiene para no producir fallos en cadena.",
                  "function detenerSi(condicion) {",
                  "  if (condicion) pm.execution.setNextRequest(null);",
                  "}",
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('guarda el teléfono y el nombre enviados', () => {",
                  "  pm.expect(cuerpo.telefono).to.eql(pm.collectionVariables.get('telefono'));",
                  "  pm.expect(cuerpo.nombre).to.eql('API-Cliente ' + pm.collectionVariables.get('run'));",
                  "});",
                  "pm.test('devuelve un id numérico', () => pm.expect(cuerpo.id).to.be.a('number'));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('clienteId', cuerpo.id);",
                  "detenerSi(pm.response.code !== 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "description": "SWR-CLI-001. Cliente ficticio \"API-Cliente <run>\" con un celular único por corrida.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"API-Cliente {{run}}\",\n  \"telefono\": \"{{telefono}}\",\n  \"autorizaDatos\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-05b Repetir el mismo teléfono → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('mensaje de teléfono duplicado', () => {",
                  "  pm.expect(cuerpo.message).to.eql('Ya existe un cliente con este teléfono');",
                  "});",
                  "pm.test('devuelve el cliente que ya tenía ese teléfono', () => {",
                  "  pm.expect(cuerpo.cliente.id).to.eql(Number(pm.collectionVariables.get('clienteId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
