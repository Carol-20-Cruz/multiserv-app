        {
          "name": "API-07 Pasar a EN_REPARACION sin abono → 409 FALTA_ABONO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('motivo = FALTA_ABONO', () => pm.expect(cuerpo.motivo).to.eql('FALTA_ABONO'));",
                  "pm.test('trae un mensaje para el usuario', () => {",
