    {
      "name": "3 Órdenes",
      "description": "Flujo principal de la orden de servicio con sus reglas de negocio (SWR-ORD-002, SWR-ORD-011, SWR-PAY-004, SWR-ENT-003; AJ-06, AJ-10). Cotización de prueba: $ 200.000, abono mínimo 50 %.",
      "item": [
        {
          "name": "API-06 Crear orden → 201 y número MS-AAAA-NNNNN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si esta petición base falla, el resto de la corrida no tiene sentido:",
                  "// se detiene para no producir fallos en cadena.",
                  "function detenerSi(condicion) {",
                  "  if (condicion) pm.execution.setNextRequest(null);",
                  "}",
                  "let cuerpo = {};",
                  "try { cuerpo = pm.response.json(); } catch (e) { cuerpo = {}; }",
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('numero cumple MS-AAAA-NNNNN', () => {",
                  "  pm.expect(cuerpo.numero).to.match(/^MS-\\d{4}-\\d{5}$/);",
                  "});",
                  "pm.test('el año del número es el año actual en Colombia', () => {",
                  "  // Colombia es UTC-5 todo el año (sin horario de verano).",
                  "  const anio = String(new Date(Date.now() - 5 * 3600 * 1000).getUTCFullYear());",
                  "  pm.expect(String(cuerpo.numero).slice(3, 7)).to.eql(anio);",
                  "});",
                  "pm.test('el consecutivo es 00001 o mayor', () => {",
                  "  pm.expect(Number(String(cuerpo.numero).slice(8))).to.be.at.least(1);",
                  "});",
                  "pm.test('la orden nace en RECIBIDO', () => pm.expect(cuerpo.estado).to.eql('RECIBIDO'));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('ordenId', cuerpo.id);",
                  "  pm.collectionVariables.set('numeroOrden', cuerpo.numero);",
                  "}",
                  "detenerSi(pm.response.code !== 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordenes"
              ]
            },
            "description": "SWR-ORD-001, SWR-ORD-002 / AJ-06. El número sigue el formato MS-AAAA-NNNNN con el año en curso (hora de Colombia) y la orden nace en RECIBIDO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"equipoId\": {{equipoId}},\n  \"fallaReportada\": \"API- prueba Postman: el equipo no enciende\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
